<div id="hd-generator-app">
  <!-- Sidebar Controls -->
  <div class="hd-controls">
    <h3>Sign Generator</h3>
    
    <label for="hd-group-input">Group Name:</label>
    <input type="text" id="hd-group-input" value="EDUCATORS" placeholder="e.g. LOGAN SQUARE" autocomplete="off">
    
    <label for="hd-size-select">Graphic Size:</label>
    <select id="hd-size-select">
      <option value="square">Social Square (1080 x 1080)</option>
      <option value="story">Instagram Story (1080 x 1920)</option>
      <option value="landscape">Facebook / Web (1200 x 628)</option>
      <option value="yardsign">Yard Sign (2400 x 1800)</option>
    </select>
    
    <button id="hd-download-btn" type="button">Download PNG</button>
  </div>

  <!-- Live Preview Area -->
  <div class="hd-preview-wrapper" id="hd-preview-wrapper">
    
    <!-- THE EXPORT CANVAS -->
    <div id="hd-canvas" class="size-square">
      
      <div class="hd-canvas-content">
        
        <!-- TOP & MIDDLE: Input Text and "FOR" Badge -->
        <div class="hd-text-group">
          <div id="hd-dynamic-group">EDUCATORS</div>
          <div class="hd-static-support">FOR</div>
        </div>

        <!-- BOTTOM: Campaign Logo -->
        <img class="hd-campaign-logo" 
             src="https://hilarioforcps.com/wp-content/uploads/2025/02/HD-Logo_2-1024x1024.png" 
             alt="Campaign Logo" 
             crossorigin="anonymous">
        
      </div>
      
    </div>
  </div>
</div>

<style>
/* App Container */
#hd-generator-app {
  display: flex;
  flex-direction: row;
  gap: 20px;
  background: #f4f4f5;
  padding: 20px;
  border-radius: 8px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
  width: 100%;
}

/* Stacks controls on top of the preview on smaller laptop/Chromebook screens */
@media (max-width: 992px) {
  #hd-generator-app {
    flex-direction: column;
  }
}

/* Sidebar Controls */
.hd-controls {
  flex: 1;
  min-width: 250px;
  display: flex;
  flex-direction: column;
  gap: 12px; 
}

.hd-controls h3 {
  margin: 0 0 5px 0;
  color: #111827;
  font-size: 1.4rem;
}

.hd-controls label {
  font-weight: 700;
  font-size: 0.9rem;
  color: #374151;
  margin-bottom: -8px;
}

.hd-controls input, 
.hd-controls select {
  width: 100%;
  padding: 10px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  font-size: 1rem;
  box-sizing: border-box;
}

.hd-controls button {
  background: #1d4ed8; 
  color: #ffffff;
  border: none;
  padding: 12px;
  border-radius: 6px;
  font-weight: 800;
  font-size: 1.1rem;
  cursor: pointer;
  transition: background 0.2s;
  margin-top: 5px;
}

.hd-controls button:hover {
  background: #1e3a8a;
}

/* Preview Wrapper - Built for Chromebook viewports */
.hd-preview-wrapper {
  flex: 2;
  width: 100%;
  min-height: 55vh; 
  background: #e5e7eb;
  border-radius: 6px;
  position: relative;
  overflow: hidden; 
}

/* 
   THE CANVAS
   Absolute positioning from the top-left center allows precise JS scaling 
*/
#hd-canvas {
  background: #f69e0b; 
  position: absolute;
  left: 50%;
  top: 50%;
  transform-origin: center center;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* Exact Output Sizes */
#hd-canvas.size-square    { width: 1080px; height: 1080px; }
#hd-canvas.size-story     { width: 1080px; height: 1920px; }
#hd-canvas.size-landscape { width: 1200px; height: 628px; }
#hd-canvas.size-yardsign  { width: 2400px; height: 1800px; }

/* Canvas Internal Layout */
.hd-canvas-content {
  width: 100%;
  height: 100%;
  padding: 8%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  color: #ffffff;
}

.hd-text-group {
  flex-grow: 1; /* Pushes the logo to the bottom */
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
}

#hd-dynamic-group {
  font-size: 160px; 
  font-weight: 900;
  text-transform: uppercase;
  line-height: 1;
  text-shadow: 4px 4px 0px #1d4ed8;
  word-wrap: break-word;
  max-width: 100%;
}

.hd-static-support {
  font-size: 70px;
  font-weight: 800;
  margin-top: 30px;
  background: #1d4ed8;
  padding: 10px 50px;
  border-radius: 100px;
}

.hd-campaign-logo {
  max-width: 75%;
  max-height: 35%;
  object-fit: contain;
  margin-top: 20px;
}

/* Adjust font sizes for specific dimensions */
#hd-canvas.size-landscape #hd-dynamic-group { font-size: 110px; }
#hd-canvas.size-landscape .hd-static-support { font-size: 50px; margin-top: 15px; }
#hd-canvas.size-landscape .hd-campaign-logo { max-height: 45%; } 

#hd-canvas.size-yardsign #hd-dynamic-group { font-size: 300px; text-shadow: 8px 8px 0px #1d4ed8; }
#hd-canvas.size-yardsign .hd-static-support { font-size: 130px; margin-top: 60px; padding: 20px 80px;}
#hd-canvas.size-yardsign .hd-campaign-logo { max-width: 80%; }
</style>

<!-- Load html2canvas -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const groupInput = document.getElementById("hd-group-input");
  const sizeSelect = document.getElementById("hd-size-select");
  const dynamicGroupText = document.getElementById("hd-dynamic-group");
  const canvasElement = document.getElementById("hd-canvas");
  const previewWrapper = document.getElementById("hd-preview-wrapper");
  const downloadBtn = document.getElementById("hd-download-btn");

  // 1. Live Text Updates
  groupInput.addEventListener("input", function() {
    dynamicGroupText.innerText = this.value || " ";
  });

  // 2. Visual Scaling Engine
  function updateScale() {
    // Reset transform to calculate raw dimensions
    canvasElement.style.transform = "translate(-50%, -50%) scale(1)";
    
    const wrapperWidth = previewWrapper.clientWidth;
    const wrapperHeight = previewWrapper.clientHeight;
    
    const canvasWidth = canvasElement.offsetWidth;
    const canvasHeight = canvasElement.offsetHeight;

    // Leave an 8% buffer margin around the preview inside the wrapper
    const scaleX = (wrapperWidth * 0.92) / canvasWidth;
    const scaleY = (wrapperHeight * 0.92) / canvasHeight;
    const scale = Math.min(scaleX, scaleY);

    // Apply exact center translation combined with the computed scale
    canvasElement.style.transform = `translate(-50%, -50%) scale(${scale})`;
  }

  // 3. Handle Size Swapping
  sizeSelect.addEventListener("change", function() {
    canvasElement.classList.remove("size-square", "size-story", "size-landscape", "size-yardsign");
    canvasElement.classList.add("size-" + this.value);
    updateScale();
  });

  // Keep it responsive on window resize
  window.addEventListener("resize", updateScale);
  
  // Initial scale on load 
  setTimeout(updateScale, 150);

  // 4. Download Function
  downloadBtn.addEventListener("click", function() {
    const originalText = downloadBtn.innerText;
    downloadBtn.innerText = "Generating...";
    downloadBtn.disabled = true;

    // Save current view state
    const currentTransform = canvasElement.style.transform;
    
    // Temporarily snap the canvas to full scale for a high-res capture
    canvasElement.style.transform = "translate(-50%, -50%) scale(1)";

    html2canvas(canvasElement, {
      scale: 1, 
      useCORS: true,
      backgroundColor: "#f69e0b"
    }).then(canvas => {
      const link = document.createElement('a');
      const sizeLabel = sizeSelect.value;
      const groupLabel = groupInput.value.replace(/[^a-z0-9]/gi, '_').toLowerCase() || 'graphic';
      
      link.download = `Hilario_${groupLabel}_${sizeLabel}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
      
      // Restore the interface
      canvasElement.style.transform = currentTransform;
      downloadBtn.innerText = originalText;
      downloadBtn.disabled = false;
    }).catch(err => {
      console.error("Export error:", err);
      alert("There was an issue generating the image. Make sure your asset URL is correct.");
      canvasElement.style.transform = currentTransform;
      downloadBtn.innerText = originalText;
      downloadBtn.disabled = false;
    });
  });
});
</script>
