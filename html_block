</style>

<!-- Load html2canvas -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const groupInput = document.getElementById("hd-group-input");
  const sizeSelect = document.getElementById("hd-size-select");
  const themeSelect = document.getElementById("hd-theme-select");
  const dynamicGroupText = document.getElementById("hd-dynamic-group");
  const canvasElement = document.getElementById("hd-canvas");
  const previewWrapper = document.getElementById("hd-preview-wrapper");
  const downloadBtn = document.getElementById("hd-download-btn");

  // Live Text Updates
  groupInput.addEventListener("input", function() {
    dynamicGroupText.innerText = this.value || " ";
  });

  // Handle Theme Swapping
  themeSelect.addEventListener("change", function() {
    canvasElement.classList.remove("theme-orange", "theme-blue");
    canvasElement.classList.add("theme-" + this.value);
  });

  // Visual Scaling Engine
  function updateScale() {
    canvasElement.style.transform = "translate(-50%, -50%) scale(1)";
    
    const wrapperWidth = previewWrapper.clientWidth;
    const wrapperHeight = previewWrapper.clientHeight;
    const canvasWidth = canvasElement.offsetWidth;
    const canvasHeight = canvasElement.offsetHeight;

    const scaleX = (wrapperWidth * 0.92) / canvasWidth;
    const scaleY = (wrapperHeight * 0.92) / canvasHeight;
    const scale = Math.min(scaleX, scaleY);

    canvasElement.style.transform = `translate(-50%, -50%) scale(${scale})`;
  }

  // Handle Size Swapping
  sizeSelect.addEventListener("change", function() {
    canvasElement.classList.remove("size-square", "size-story", "size-landscape", "size-yardsign");
    canvasElement.classList.add("size-" + this.value);
    updateScale();
  });

  window.addEventListener("resize", updateScale);
  setTimeout(updateScale, 150);

  // Download Function
  downloadBtn.addEventListener("click", function() {
    const originalText = downloadBtn.innerText;
    downloadBtn.innerText = "Generating...";
    downloadBtn.disabled = true;

    const currentTransform = canvasElement.style.transform;
    canvasElement.style.transform = "translate(-50%, -50%) scale(1)";

    // Use CORS to ensure external assets map correctly on export
    html2canvas(canvasElement, {
      scale: 1, 
      useCORS: true,
      backgroundColor: null
    }).then(canvas => {
      const link = document.createElement('a');
      const sizeLabel = sizeSelect.value;
      const themeLabel = themeSelect.value;
      const groupLabel = groupInput.value.replace(/[^a-z0-9]/gi, '_').toLowerCase() || 'graphic';
      
      link.download = `Hilario_${groupLabel}_${themeLabel}_${sizeLabel}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
      
      canvasElement.style.transform = currentTransform;
      downloadBtn.innerText = originalText;
      downloadBtn.disabled = false;
    }).catch(err => {
      console.error("Export error:", err);
      alert("There was an issue generating the image. Make sure your asset URL allows cross-origin requests.");
      canvasElement.style.transform = currentTransform;
      downloadBtn.innerText = originalText;
      downloadBtn.disabled = false;
    });
  });
});
</script>
